<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.demo.repository.AuthRepository">

    <select id="getLastInsertId" parameterType="long">
        SELECT LAST_INSERT_ID()
    </select>

    <select id="findByRefreshToken" parameterType="String" resultType="com.example.demo.vo.Auth">
        SELECT *
        FROM auth
        WHERE refreshToken = #{refreshToken}
    </select>

    <update id="updateAccessToken">
        UPDATE auth
        SET accessToken = #{newAccessToken},
            updateDate = NOW()
        WHERE memberId = #{id}
    </update>

    <select id="getTokenByMemberIdAndProvider" resultType="String">
        SELECT oauthId
        FROM oauthAccount
        WHERE memberId = #{memberId}
        AND provider = #{provider}
    </select>

</mapper>

